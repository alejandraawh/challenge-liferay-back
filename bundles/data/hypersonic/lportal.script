INSERT INTO NOTIFICATIONTEMPLATE VALUES(0,'ffa70a7c-0c87-4e12-af66-b11ead37f181','L_COMMERCE_ORDER_TEMPLATE',30402,59206091757698,20123,'Test Test','2025-02-18 21:20:54.408000','2025-02-18 21:20:54.408000',0,'<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Body language-id="en_US">&lt;html&gt;\u000a&lt;head&gt;\u000a\u0009&lt;meta content="width=device-width, initial-scale=1" name="viewport" /&gt;\u000a\u0009&lt;style type="text/css"&gt;\u000a\u0009\u0009html, body {\u000a\u0009\u0009\u0009background-color: #FFF;\u000a\u0009\u0009\u0009color: #272833;\u000a\u0009\u0009\u0009margin: 0;\u000a\u0009\u0009\u0009padding: 0;\u000a\u0009\u0009\u0009width: 100%;\u000a\u0009\u0009}\u000a\u0009\u0009.banner {\u000a\u0009\u0009\u0009background: linear-gradient(120deg, #011181 0%,#0c6297 45%,#0c6297 50%,#7eefec 100%);\u000a\u0009\u0009\u0009border-radius: 8px 8px 0 0;\u000a\u0009\u0009\u0009height: 56px;\u000a\u0009\u0009}\u000a\u0009\u0009.container {\u000a\u0009\u0009\u0009background-color: #F7F8F9;\u000a\u0009\u0009\u0009border-radius: 20px;\u000a\u0009\u0009\u0009box-sizing: border-box;\u000a\u0009\u0009\u0009font-family: ''Roboto'', sans-serif;\u000a\u0009\u0009\u0009font-size: 14px;\u000a\u0009\u0009\u0009margin: 48px auto;\u000a\u0009\u0009\u0009max-width: 640px;\u000a\u0009\u0009\u0009min-width: 320px;\u000a\u0009\u0009\u0009overflow: hidden;\u000a\u0009\u0009\u0009padding: 32px 48px;\u000a\u0009\u0009}\u000a\u0009\u0009.content {\u000a\u0009\u0009\u0009box-sizing: border-box;\u000a\u0009\u0009\u0009margin-top: 14px;\u000a\u0009\u0009}\u000a\u0009\u0009.footer {\u000a\u0009\u0009\u0009color: #6B6C7E;\u000a\u0009\u0009\u0009font-size: 14px;\u000a\u0009\u0009\u0009line-height: 21px;\u000a\u0009\u0009\u0009text-align: center;\u000a\u0009\u0009}\u000a\u0009\u0009.section {\u000a\u0009\u0009\u0009background-color: #FFF;\u000a\u0009\u0009\u0009border-radius: 8px;\u000a\u0009\u0009\u0009margin-bottom: 24px;\u000a\u0009\u0009\u0009overflow: hidden;\u000a\u0009\u0009\u0009padding-bottom: 1px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-address-section, \u000a\u0009\u0009.order-confirmation-section, \u000a\u0009\u0009.order-details-section, \u000a\u0009\u0009.order-items-section {\u000a\u0009\u0009\u0009border-bottom: 1px solid #E7E7ED;\u000a\u0009\u0009\u0009margin: 0 24px;\u000a\u0009\u0009\u0009padding: 0 0 24px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-confirmation-section h3 {\u000a\u0009\u0009\u0009font-size: 18px;\u000a\u0009\u0009\u0009font-weight: 500;\u000a\u0009\u0009\u0009margin: 20px 0;\u000a\u0009\u0009}\u000a\u0009\u0009.help-section h4,\u000a\u0009\u0009.order-address-section h4, \u000a\u0009\u0009.order-details-section h4, \u000a\u0009\u0009.order-items-section h4,\u000a\u0009\u0009.order-items-section h4,\u000a\u0009\u0009.order-items-section th {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009font-weight: 600;\u000a\u0009\u0009\u0009margin: 20px 0;\u000a\u0009\u0009\u0009text-align:left;\u000a\u0009\u0009}\u000a\u0009\u0009.help-section {\u000a\u0009\u0009\u0009padding: 1px 24px 8px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-summary-section {\u000a\u0009\u0009\u0009background-color: #F0F5FF;\u000a\u0009\u0009\u0009border-radius: 8px;\u000a\u0009\u0009\u0009margin: 24px;\u000a\u0009\u0009\u0009padding: 24px;\u000a\u0009\u0009\u0009text-align: right;\u000a\u0009\u0009}\u000a\u0009\u0009.order-summary-section div {\u000a\u0009\u0009\u0009line-height: 18px;\u000a\u0009\u0009}\u000a\u0009\u0009.summary-helper {\u000a\u0009\u0009\u0009font-size: 12px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-items,\u000a\u0009\u0009.order-items table {\u000a\u0009\u0009\u0009width: 100%;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info th {\u000a\u0009\u0009\u0009margin-bottom: 5px;\u000a\u0009\u0009\u0009text-align:left;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price table {\u000a\u0009\u0009\u0009text-align: right;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price td {\u000a\u0009\u0009\u0009white-space: nowrap;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-discount-price {\u000a\u0009\u0009\u0009color:#FF0000;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info {\u000a\u0009\u0009\u0009padding-right: 16px;\u000a\u0009\u0009\u0009vertical-align: top;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info td {\u000a\u0009\u0009\u0009font-size: 12px;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info-label {\u000a\u0009\u0009\u0009display: block;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-info-label td:first-child {\u000a\u0009\u0009\u0009font-weight: bold;\u000a\u0009\u0009\u0009padding: 0;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-original-price {\u000a\u0009\u0009\u0009text-decoration: line-through;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-price {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009font-weight: bold;\u000a\u0009\u0009\u0009vertical-align: top;\u000a\u0009\u0009}\u000a\u0009\u0009.order-item-title {\u000a\u0009\u0009\u0009font-size: 16px;\u000a\u0009\u0009\u0009padding: 0px;\u000a\u0009\u0009\u0009text-align: left;\u000a\u0009\u0009}\u000a\u0009\u0009.order-items {\u000a\u0009\u0009\u0009border-collapse: inherit;\u000a\u0009\u0009\u0009border-spacing: 0 16px;\u000a\u0009\u0009\u0009text-align: left;\u000a\u0009\u0009}\u000a\u0009\u0009@media only screen and (max-width: 640px) {\u000a\u0009\u0009\u0009.container { \u000a\u0009\u0009\u0009\u0009margin: 0 auto !important;\u000a\u0009\u0009\u0009\u0009padding: 24px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-items .order-item-img {\u000a\u0009\u0009\u0009\u0009height: 60px !important;\u000a\u0009\u0009\u0009\u0009vertical-align: top !important;\u000a\u0009\u0009\u0009\u0009width: 60px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-items .order-item-img img {\u000a\u0009\u0009\u0009\u0009max-height: 60px !important;\u000a\u0009\u0009\u0009\u0009max-width: 60px !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009\u0009.order-item-info {\u000a\u0009\u0009\u0009\u0009max-width: 80% !important;\u000a\u0009\u0009\u0009}\u000a\u0009\u0009}\u000a\u0009&lt;/style&gt;&lt;/head&gt;&lt;body&gt;\u000a\u0009\u0009&lt;div class="container"&gt;\u000a\u0009\u0009\u0009&lt;div class="content"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div class="section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="banner"&gt;&amp;nbsp;&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-confirmation-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h3&gt;Order confirmation&lt;/h3&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;Hi, [%COMMERCEORDER_AUTHOR_PREFIX%] &lt;b&gt;[%COMMERCEORDER_AUTHOR_FIRST_NAME%] [%COMMERCEORDER_AUTHOR_LAST_NAME%]&lt;/b&gt; [%COMMERCEORDER_AUTHOR_SUFFIX%]&lt;br /&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009Thank you for your order! Here is your order summary and delivery details. We will prepare your order as soon as possible and you will receive another email when it has been shipped.&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-details-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Order details&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Order Number&lt;/b&gt;: #[%COMMERCEORDER_ID%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Order Date&lt;/b&gt;: [%COMMERCEORDER_ORDERDATE%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Account&lt;/b&gt;: [%COMMERCEORDER_ACCOUNT_NAME%] - #[%COMMERCEORDER_ACCOUNTID%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-address-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Address&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Billing Address&lt;/b&gt;: [%COMMERCEORDER_BILLING_ADDRESS_STREET1%] [%COMMERCEORDER_BILLING_ADDRESS_STREET2%] [%COMMERCEORDER_BILLING_ADDRESS_STREET3%], [%COMMERCEORDER_BILLING_ADDRESS_ZIP%] [%COMMERCEORDER_BILLING_ADDRESS_CITY%], [%COMMERCEORDER_BILLING_ADDRESS_REGION%] [%COMMERCEORDER_BILLING_ADDRESS_COUNTRY%]&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Shipping Address&lt;/b&gt;: [%COMMERCEORDER_SHIPPING_ADDRESS_STREET1%] [%COMMERCEORDER_SHIPPING_ADDRESS_STREET2%] [%COMMERCEORDER_SHIPPING_ADDRESS_STREET3%], [%COMMERCEORDER_SHIPPING_ADDRESS_ZIP%] [%COMMERCEORDER_SHIPPING_ADDRESS_CITY%], [%COMMERCEORDER_SHIPPING_ADDRESS_REGION%] [%COMMERCEORDER_SHIPPING_ADDRESS_COUNTRY%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-items-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;[%COMMERCEORDER_ORDER_ITEMS%]&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;div class="order-summary-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div&gt;&lt;b&gt;Total: [%COMMERCEORDER_TOTALFORMATTED%]&lt;/b&gt;&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009\u0009&lt;div class="summary-helper"&gt;Including Tax&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009&lt;div class="section"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div class="help-section"&gt;\u000a\u0009\u0009\u0009\u0009\u0009&lt;h4&gt;Do you need help?&lt;/h4&gt;\u000a\u000a\u0009\u0009\u0009\u0009\u0009&lt;p&gt;If you have any questions, please contact us.&lt;/p&gt;\u000a\u0009\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u000a\u0009\u0009\u0009&lt;div class="footer"&gt;\u000a\u0009\u0009\u0009\u0009&lt;div&gt;Copyright \u00a9 2024&lt;/div&gt;\u000a\u0009\u0009\u0009&lt;/div&gt;\u000a\u0009\u0009&lt;/div&gt;\u000a\u0009&lt;/body&gt;\u000a\u0009&lt;/html&gt;</Body></root>',NULL,'richText','Commerce Order Notification','email','<?xml version="1.0" ?><root available-locales="en_US" default-locale="en_US"><Subject language-id="en_US">Order #[%COMMERCEORDER_ID%]</Subject></root>','0','email')
