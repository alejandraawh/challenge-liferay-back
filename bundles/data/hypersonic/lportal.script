INSERT INTO KALEODEFINITION VALUES(1,0,'15cb36c9-6dbe-becd-4168-92dd7a637efd','15cb36c9-6dbe-becd-4168-92dd7a637efd',31536,0,59206091757698,20096,NULL,'2025-02-18 21:21:10.244000','2025-02-18 21:21:10.260000','message-boards-user-stats-moderation','<?xml version="1.0" ?><root available-locales="en_US,sv_SE,pt_BR,fr_FR,ja_JP,ca_ES,de_DE,hu_HU,ar_SA,fi_FI,zh_CN,es_ES,nl_NL" default-locale="en_US"><title language-id="sv_SE">Moderering av anv\u00e4ndarstatistik f\u00f6r diskussionsforum</title><title language-id="pt_BR">Modera\u00e7\u00e3o de estat\u00edsticas de usu\u00e1rio do f\u00f3rum</title><title language-id="fr_FR">Mod\u00e9ration sur statistiques utilisateur des forums de discussion</title><title language-id="ja_JP">\u63b2\u793a\u677f\u30e6\u30fc\u30b6\u30fc\u7d71\u8a08\u306e\u627f\u8a8d</title><title language-id="ca_ES">Moderaci\u00f3 de les estad\u00edstiques d''usuari dels taulers de missatges</title><title language-id="de_DE">Moderation der Foren-Benutzerstatistiken</title><title language-id="hu_HU">F\u00f3rumok felhaszn\u00e1l\u00f3i statisztik\u00e1inak a moder\u00e1l\u00e1sa</title><title language-id="ar_SA">\u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0639\u0644\u0649 \u0625\u062d\u0635\u0627\u0621\u0627\u062a \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0648\u062d\u0627\u062a \u0627\u0644\u0631\u0633\u0627\u0626\u0644</title><title language-id="fi_FI">Keskustelualueiden k\u00e4ytt\u00e4j\u00e4tilastojen moderointi</title><title language-id="en_US">Message Boards User Stats Moderation</title><title language-id="zh_CN">\u7559\u8a00\u677f\u7528\u6237\u7edf\u8ba1\u5ba1\u6838</title><title language-id="es_ES">Moderaci\u00f3n de estad\u00edsticas de usuario de los foros de discusi\u00f3n</title><title language-id="nl_NL">Moderatiestatistieken forumgebruiker</title></root>','Users with a reputation over the threshold get their threads and comments approved automatically.','{"#tag-name":"workflow-definition","#child-nodes":[{"#tag-name":"name","#value":"Messag